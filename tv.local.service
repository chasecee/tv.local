[Unit]
Description=TV Local Service
After=network.target pigpiod.service
Requires=pigpiod.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/tv.local
ExecStart=/home/pi/tv.local/dist/tvlocal/tvlocal
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=GPIOZERO_PIN_FACTORY=pigpio

[Install]
WantedBy=multi-user.target 